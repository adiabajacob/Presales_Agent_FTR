# ──────────────────────────────────────────────────────────────────────────────
# AWS Configuration (Target: Dual Account Setup)
# ──────────────────────────────────────────────────────────────────────────────

# --- 1. APN Account (for Partner Central Tools) ---
# [RECOMMENDED] Use a named profile from ~/.aws/credentials
# Run 'aws sso login --profile my-apn-profile' first!
APN_AWS_PROFILE=my-apn-profile

# [ALTERNATIVE] Explicit Keys (Comment out APN_AWS_PROFILE above if using this)
# APN_AWS_ACCESS_KEY_ID=...
# APN_AWS_SECRET_ACCESS_KEY=...
# APN_AWS_SESSION_TOKEN=...
# APN_AWS_REGION=us-east-1

# --- 2. Bedrock Account (for LLM) ---
# [RECOMMENDED] Use a named profile
# Run 'aws sso login --profile my-bedrock-profile' first!
BEDROCK_AWS_PROFILE=my-bedrock-profile

# [ALTERNATIVE] Explicit Keys (Comment out BEDROCK_AWS_PROFILE above if using this)
# BEDROCK_AWS_ACCESS_KEY_ID=...
# BEDROCK_AWS_SECRET_ACCESS_KEY=...
# BEDROCK_AWS_SESSION_TOKEN=...
# BEDROCK_AWS_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────────────
# Model Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Default is now set to Bedrock Sonnet 4. 
# You can override it here if needed.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# If you want to switch back to local Ollama, edit src/models.py
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest
