
# ------------------------------------------------------------------------------
# AWS Credentials (Single Account - Standard)
# ------------------------------------------------------------------------------
# Leave these uncommented and fill them in if you are using temporary credentials
# directly in the .env file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# AWS Profiles (Advanced - Dual Account)
# ------------------------------------------------------------------------------
# Use these if you have configured profiles in ~/.aws/config via `aws configure sso`
# APN_AWS_PROFILE=my-apn-profile
# BEDROCK_AWS_PROFILE=my-bedrock-profile

# ------------------------------------------------------------------------------
# Login Instructions
# ------------------------------------------------------------------------------
# Option 1: Env Vars (Paste into .env or export in shell)
# Option 2: SSO Profiles (aws sso login --profile ...)